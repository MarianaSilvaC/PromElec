# =====================================================================================
# Secretos del SERVIDOR para deploy/docker-compose.yml.
# En el servidor NO copies este archivo: el .env se genera con valores aleatorios
# siguiendo docs/Despliegue.md (paso 4). Esta plantilla solo muestra qué variables existen.
# =====================================================================================

# IP pública del VPS (o dominio). La API solo acepta peticiones dirigidas a este nombre.
SERVER_HOST=203.0.113.10

# Contraseña del usuario "sa" de SQL Server (8+ caracteres, mayúsculas, minúsculas y números).
MSSQL_SA_PASSWORD=CambiaEsto-Sql-2026

# Llave de firma de los tokens JWT (32+ caracteres aleatorios).
JWT_KEY=CambiaEsto-UnaLlaveLargaYAleatoriaDeAlMenos32Caracteres

# Contraseña inicial de admin@promelec.local (mayúscula, minúscula, número y símbolo).
ADMIN_PASSWORD=CambiaEsto-Admin-2026

# (Opcional) Otra versión de la imagen de Docker Hub.
# API_IMAGE=marianasilcam05/promelec-api:1.0
