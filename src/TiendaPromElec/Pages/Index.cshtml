@page
@model TiendaPromElec.Pages.IndexModel
@{
    ViewData["Title"] = "Catálogo de Productos";
    var mx = System.Globalization.CultureInfo.GetCultureInfo("es-MX");
}

<div class="text-center mb-4">
    <h1 class="display-4">Nuestro Catálogo</h1>
</div>

<div class="row">
    @foreach (var item in Model.Products)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @* Razor codifica todo lo que imprime con @, así que no hay riesgo de XSS. *@
                <img src="@item.ImageUrl" class="card-img-top producto-img object-fit-cover" alt="@item.Name">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Description</p>
                    <p class="card-text"><small class="text-muted">Marca: @item.Brand · @item.CategoryName</small></p>
                    <p class="card-text"><strong>Precio: @item.Price.ToString("C", mx)</strong></p>
                </div>
            </div>
        </div>
    }
</div>
