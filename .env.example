# =====================================================================================
# Plantilla de secretos para docker compose.
# 1. Copia este archivo con el nombre ".env" (en la misma carpeta que docker-compose.yml).
# 2. Reemplaza cada valor por uno propio y aleatorio.
# El archivo .env NO se sube a git (está en .gitignore). Este .env.example sí, porque no tiene secretos reales.
# Evita los caracteres ; " ' y espacios en los valores.
# =====================================================================================

# Contraseña del usuario "sa" de SQL Server: mínimo 8 caracteres, con mayúsculas, minúsculas y números.
MSSQL_SA_PASSWORD=CambiaEsto-Sql-2026

# Llave para firmar los tokens JWT: mínimo 32 caracteres aleatorios.
# Genera una en PowerShell con:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_KEY=CambiaEsto-UnaLlaveLargaYAleatoriaDeAlMenos32Caracteres

# Contraseña inicial del usuario admin@promelec.local: mínimo 8, con mayúscula, minúscula, número y símbolo.
ADMIN_PASSWORD=CambiaEsto-Admin-2026

# (Opcional) Imagen de la API. Por defecto se usa la imagen local "promelec-api:1.0".
# API_IMAGE=tuusuario/promelec-api:1.0
